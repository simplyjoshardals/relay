  if (!connected) {
    return (
      <span className="inline-flex items-center gap-1.5 rounded-full bg-warning/10 px-2.5 py-1 text-xs font-medium text-warning">
        <span className="size-1.5 rounded-full bg-warning" />
        Reconnecting
